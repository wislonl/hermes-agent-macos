{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.dev/schemas/hermes-protocol.schema.json",
  "title": "Hermes Protocol",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/jsonRpcRequest"
    },
    {
      "$ref": "#/$defs/jsonRpcResponse"
    },
    {
      "$ref": "#/$defs/runtimeEvent"
    }
  ],
  "$defs": {
    "jsonRpcRequest": {
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/runtimeHandshakeRequest"
        },
        {
          "$ref": "#/$defs/runCreateRequest"
        },
        {
          "$ref": "#/$defs/approvalResolveRequest"
        }
      ]
    },
    "jsonRpcResponse": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "result": {
          "$ref": "#/$defs/jsonRpcResult"
        },
        "error": {
          "$ref": "#/$defs/jsonRpcError"
        }
      },
      "oneOf": [
        {
          "required": [
            "result"
          ]
        },
        {
          "required": [
            "error"
          ]
        }
      ],
      "additionalProperties": false
    },
    "jsonRpcResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/runtimeHandshakeResult"
        },
        {
          "$ref": "#/$defs/runCreateResult"
        },
        {
          "$ref": "#/$defs/approvalResolveResult"
        }
      ]
    },
    "runtimeHandshakeResult": {
      "type": "object",
      "required": [
        "protocolVersion",
        "runtime",
        "capabilities"
      ],
      "properties": {
        "protocolVersion": {
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/runtimeInfo"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "runtimeInfo": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runCreateResult": {
      "type": "object",
      "required": [
        "runId",
        "status"
      ],
      "properties": {
        "runId": {
          "type": "string"
        },
        "status": {
          "const": "running"
        }
      },
      "additionalProperties": false
    },
    "approvalResolveResult": {
      "type": "object",
      "required": [
        "approvalId",
        "status"
      ],
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "status": {
          "const": "resolved"
        }
      },
      "additionalProperties": false
    },
    "jsonRpcError": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "runtimeEvent": {
      "required": [
        "event",
        "runId"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/messageDeltaEvent"
        },
        {
          "$ref": "#/$defs/toolRequestedEvent"
        },
        {
          "$ref": "#/$defs/approvalRequiredEvent"
        },
        {
          "$ref": "#/$defs/toolResultEvent"
        },
        {
          "$ref": "#/$defs/runCompletedEvent"
        },
        {
          "$ref": "#/$defs/runFailedEvent"
        }
      ]
    },
    "jsonRpcRequestBase": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "runtimeHandshakeRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/jsonRpcRequestBase"
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "const": "runtime.handshake"
            },
            "params": {
              "$ref": "#/$defs/runtimeHandshakeParams"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runCreateRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/jsonRpcRequestBase"
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "const": "run.create"
            },
            "params": {
              "$ref": "#/$defs/runCreateParams"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "approvalResolveRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/jsonRpcRequestBase"
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "const": "approval.resolve"
            },
            "params": {
              "$ref": "#/$defs/approvalResolveParams"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runtimeHandshakeParams": {
      "type": "object",
      "required": [
        "protocolVersion",
        "client"
      ],
      "properties": {
        "protocolVersion": {
          "type": "string"
        },
        "client": {
          "$ref": "#/$defs/clientInfo"
        }
      },
      "additionalProperties": false
    },
    "clientInfo": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runCreateParams": {
      "type": "object",
      "required": [
        "sessionId",
        "agentProfileId",
        "input",
        "workspace"
      ],
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "agentProfileId": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/runInput"
        },
        "workspace": {
          "$ref": "#/$defs/workspace"
        }
      },
      "additionalProperties": false
    },
    "runInput": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "approvalResolveParams": {
      "type": "object",
      "required": [
        "approvalId",
        "decision"
      ],
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "approved",
            "denied"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtimeEventBase": {
      "type": "object",
      "required": [
        "event",
        "runId"
      ],
      "properties": {
        "event": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        }
      }
    },
    "messageDeltaEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/runtimeEventBase"
        },
        {
          "type": "object",
          "required": [
            "delta"
          ],
          "properties": {
            "event": {
              "const": "message.delta"
            },
            "messageId": {
              "type": "string"
            },
            "delta": {
              "type": "string"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "toolRequestedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/runtimeEventBase"
        },
        {
          "type": "object",
          "required": [
            "toolCallId",
            "tool",
            "summary"
          ],
          "properties": {
            "event": {
              "const": "tool.requested"
            },
            "toolCallId": {
              "type": "string"
            },
            "tool": {
              "$ref": "#/$defs/toolName"
            },
            "summary": {
              "type": "string"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "approvalRequiredEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/runtimeEventBase"
        },
        {
          "type": "object",
          "required": [
            "approvalId",
            "toolCallId",
            "operation"
          ],
          "properties": {
            "event": {
              "const": "approval.required"
            },
            "approvalId": {
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "operation": {
              "$ref": "#/$defs/toolOperation"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "toolResultEvent": {
      "oneOf": [
        {
          "$ref": "#/$defs/toolResultCompletedEvent"
        },
        {
          "$ref": "#/$defs/toolResultFailedEvent"
        }
      ]
    },
    "toolResultCompletedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/runtimeEventBase"
        },
        {
          "type": "object",
          "required": [
            "toolCallId",
            "status",
            "outputPreview"
          ],
          "properties": {
            "event": {
              "const": "tool.result"
            },
            "toolCallId": {
              "type": "string"
            },
            "status": {
              "const": "completed"
            },
            "outputPreview": {
              "type": "string"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "toolResultFailedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/runtimeEventBase"
        },
        {
          "type": "object",
          "required": [
            "toolCallId",
            "status",
            "error"
          ],
          "properties": {
            "event": {
              "const": "tool.result"
            },
            "toolCallId": {
              "type": "string"
            },
            "status": {
              "const": "failed"
            },
            "error": {
              "$ref": "#/$defs/jsonRpcError"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runCompletedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/runtimeEventBase"
        },
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "event": {
              "const": "run.completed"
            },
            "status": {
              "const": "completed"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runFailedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/runtimeEventBase"
        },
        {
          "type": "object",
          "required": [
            "status",
            "error"
          ],
          "properties": {
            "event": {
              "const": "run.failed"
            },
            "status": {
              "const": "failed"
            },
            "error": {
              "$ref": "#/$defs/jsonRpcError"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "toolName": {
      "enum": [
        "shell",
        "file.read",
        "file.write"
      ]
    },
    "toolOperation": {
      "oneOf": [
        {
          "$ref": "#/$defs/shellToolOperation"
        },
        {
          "$ref": "#/$defs/fileReadToolOperation"
        },
        {
          "$ref": "#/$defs/fileWriteToolOperation"
        }
      ]
    },
    "shellToolOperation": {
      "type": "object",
      "required": [
        "tool",
        "command",
        "workingDirectory",
        "risk"
      ],
      "properties": {
        "tool": {
          "const": "shell"
        },
        "command": {
          "type": "string"
        },
        "workingDirectory": {
          "type": "string"
        },
        "risk": {
          "const": "executes-command"
        }
      },
      "additionalProperties": false
    },
    "fileReadToolOperation": {
      "type": "object",
      "required": [
        "tool",
        "path",
        "risk"
      ],
      "properties": {
        "tool": {
          "const": "file.read"
        },
        "path": {
          "type": "string"
        },
        "risk": {
          "const": "read-only"
        }
      },
      "additionalProperties": false
    },
    "fileWriteToolOperation": {
      "type": "object",
      "required": [
        "tool",
        "path",
        "mode",
        "contentPreview",
        "byteCount",
        "contentSha256",
        "risk"
      ],
      "properties": {
        "tool": {
          "const": "file.write"
        },
        "path": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "create",
            "overwrite",
            "append"
          ]
        },
        "contentPreview": {
          "type": "string"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "risk": {
          "const": "writes-files"
        }
      },
      "additionalProperties": false
    }
  }
}
